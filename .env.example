POSTGRES_DB=youtube_analytics
POSTGRES_USER=youtube
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://youtube:change-this-local-password@postgres:5432/youtube_analytics
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/callback
APP_SECRET_KEY=replace-with-a-long-random-local-secret
PUBLIC_SYNC_CRON=0 */6 * * *
ANALYTICS_SYNC_CRON=20 5 * * *
COMPETITOR_SYNC_CRON=40 5 * * *
DAILY_ANALYSIS_CRON=0 6 * * *
BACKUP_SCHEDULE=0 3 * * *
BACKUP_DIR=/app/data/backups
RAW_DATA_RETENTION_DAYS=3650
SNAPSHOT_RETENTION_DAYS=3650
ANALYTICS_RETENTION_DAYS=3650
YOUTUBE_DAILY_QUOTA_BUDGET=10000
MOCK_MODE=false
